# PowerShell example: $env:EVORAG_RUNTIME__BASE_URL = 'http://localhost:11434'
# The application reads process environment variables. Set them before starting the server.
EVORAG_RUNTIME__BASE_URL=http://localhost:11434
EVORAG_RUNTIME__GENERATION_MODEL=qwen3:4b-instruct
EVORAG_RUNTIME__EMBEDDING_MODEL=qwen3-embedding:0.6b
